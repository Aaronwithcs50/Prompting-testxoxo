<%
  const safeGuilds = guilds || [];
  const managedCount = safeGuilds.length;
  const premiumCount = safeGuilds.filter(g => g.features && g.features.length).length;
  const animatedCount = safeGuilds.filter(g => g.icon).length;
  const permissionScore = Math.min(100, Math.round((managedCount / Math.max(managedCount, 8)) * 100));
  const escapeHtml = (value = '') => String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
%>
<%- include('layouts/main', { body: `
<section class="dashboard-hero" data-magnetic-zone>
  <div class="hero-orb hero-orb-one"></div>
  <div class="hero-orb hero-orb-two"></div>
  <div class="hero-copy">
    <span class="eyebrow">Componentry-inspired command center</span>
    <h1 class="kinetic-title" data-letter-cascade>Manage every Discord server with motion and clarity.</h1>
    <p>Search your guilds, monitor setup health, and jump into modules from an animated dashboard built with lightweight interactions inspired by Componentry's crafted primitives.</p>
    <div class="hero-actions">
      <a class="btn btn-lg" href="#guilds">Browse guilds</a>
      <button class="btn btn-ghost" type="button" data-scroll-target="#insights">View insights</button>
    </div>
  </div>
  <div class="split-flap-card" aria-label="Managed guild count">
    <span class="split-label">Managed Guilds</span>
    <div class="split-value" data-count-up="${managedCount}">0</div>
    <span class="split-caption">ready to configure</span>
  </div>
</section>

<section class="dashboard-insights" id="insights">
  <article class="metric-card card">
    <span class="metric-label">Setup coverage</span>
    <strong data-count-up="${permissionScore}">0</strong><span class="metric-suffix">%</span>
    <div class="metric-bar"><span style="width:${permissionScore}%"></span></div>
  </article>
  <article class="metric-card card">
    <span class="metric-label">Custom icons</span>
    <strong data-count-up="${animatedCount}">0</strong>
    <p>Guilds with recognizable branding.</p>
  </article>
  <article class="metric-card card">
    <span class="metric-label">Feature-rich servers</span>
    <strong data-count-up="${premiumCount}">0</strong>
    <p>Servers exposing Discord feature flags.</p>
  </article>
</section>

<section class="component-showcase card">
  <div>
    <span class="eyebrow">Quick actions</span>
    <h2>Magnetic module dock</h2>
    <p>Hover the dock to preview the same high-motion feel used throughout the new dashboard experience.</p>
  </div>
  <div class="magnetic-dock" data-magnetic-dock>
    <a href="/dashboard" aria-label="Guilds"><i data-feather="grid"></i><span>Guilds</span></a>
    <a href="#guilds" aria-label="Search"><i data-feather="search"></i><span>Search</span></a>
    <a href="#insights" aria-label="Insights"><i data-feather="bar-chart-2"></i><span>Insights</span></a>
    <a href="/" aria-label="Home"><i data-feather="home"></i><span>Home</span></a>
  </div>
</section>

<section class="guild-section" id="guilds">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Guild browser</span>
      <h2>Your Guilds</h2>
    </div>
    <input class="input guild-search" data-filter placeholder="Search guilds by name or id" aria-label="Search guilds">
  </div>
  <div class="grid guild-grid">
    ${safeGuilds.map((g, index)=>`
      <article class="card guild-card reveal-card" style="--delay:${index * 60}ms">
        <div class="guild-avatar">${escapeHtml((g.name || '?').trim().charAt(0).toUpperCase())}</div>
        <div class="guild-card-body">
          <h3>${escapeHtml(g.name)}</h3>
          <p>${escapeHtml(g.id)}</p>
        </div>
        <a class="btn" href="/dashboard/${escapeHtml(g.id)}">Manage</a>
      </article>`).join('') || `<article class="card empty-state"><h3>No manageable guilds found</h3><p>Log in with an account that has Manage Server permissions to see guilds here.</p></article>`}
  </div>
</section>
` }) %>
