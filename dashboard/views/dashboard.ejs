<%
  const safeGuilds = guilds || [];
  const displayName = (user && (user.global_name || user.username)) || 'Lexi';
  const avatarUrl = user && user.id && user.avatar
    ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=96`
    : 'https://api.dicebear.com/8.x/bottts-neutral/svg?seed=Melonly';
  const escapeHtml = (value = '') => String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const cards = safeGuilds.length ? safeGuilds : [
    { id: 'preview-1', name: 'cbrp', features: ['VIP'], approximate_member_count: 0 },
    { id: 'preview-2', name: 'CaliforniaRoleplay', features: ['VIP'], approximate_member_count: 0 },
    { id: 'preview-3', name: 'San Antonio texas state roleplay', features: ['VIP'], approximate_member_count: 0 }
  ];
%>
<%- include('layouts/main', { body: `
<section class="melonly-shell">
  <div class="welcome-row">
    <img class="welcome-avatar" src="${avatarUrl}" alt="${escapeHtml(displayName)} avatar">
    <h1>Happy Summer, <span>${escapeHtml(displayName)}!</span></h1>
  </div>

  <div class="quick-actions" aria-label="Quick actions">
    <a class="action-pill action-join" href="/login"><i data-feather="log-in"></i>Join</a>
    <a class="action-pill action-new" href="#guilds"><i data-feather="plus"></i>New</a>
    <button class="action-pill action-blue" type="button"><i data-feather="calendar"></i>Manage Leave of Absences</button>
    <button class="action-pill action-blue" type="button"><i data-feather="star"></i>Get Subscriptions</button>
  </div>

  <aside class="pro-banner">
    <div class="pro-mark" aria-hidden="true"></div>
    <div>
      <strong>Need more power? Go Pro.</strong>
      <p>Unlock Melonly Pro for advanced tools, Vision access, and a faster moderation workflow.</p>
    </div>
    <span>MELONLY</span>
  </aside>

  <section class="server-panel" id="guilds">
    <div class="panel-heading">
      <div>
        <h2>My Servers &amp; Departments</h2>
        <p>Here are the servers and departments that you are a member of.</p>
      </div>
      <div class="view-toggles" aria-hidden="true"><button><i data-feather="grid"></i></button><i data-feather="list"></i></div>
    </div>

    <div class="server-grid">
      ${cards.map((g, index) => {
        const guildName = escapeHtml(g.name || 'Untitled server');
        const guildId = escapeHtml(g.id || '');
        const isReal = !String(g.id || '').startsWith('preview-');
        const members = g.approximate_member_count || g.memberCount || 0;
        const iconUrl = g.icon && g.id ? `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png?size=64` : '';
        const showIcon = iconUrl && index === 2;
        return `<article class="server-card" style="--delay:${index * 70}ms">
          <div class="server-cover"></div>
          <div class="server-body">
            <div class="server-title-row">
              <div class="server-title">${showIcon ? `<img class="server-icon" src="${iconUrl}" alt="${guildName} icon">` : ''}<h3>${guildName}</h3></div>
              <div class="server-tools"><i data-feather="crown"></i><i data-feather="more-vertical"></i></div>
            </div>
            ${index === 0 ? `<div class="quick-access"><i data-feather="keyboard"></i>Quick Access: Press Ctrl + Enter</div>` : ''}
            ${index === 2 ? `<p class="players"><i data-feather="users"></i>${members} players</p>` : ''}
            <nav class="server-links">
              <a href="${isReal ? `/dashboard/${guildId}` : '#'}"><i data-feather="grid"></i>Dashboard</a>
              <a href="${isReal ? `/dashboard/${guildId}/moderation` : '#'}"><i data-feather="shield"></i>Moderator Panel</a>
              <a href="${isReal ? `/dashboard/${guildId}/general` : '#'}"><i data-feather="folder"></i>Resources</a>
            </nav>
            ${index === 2 ? '<p class="weekly">4 unique players this week</p><div class="sparkline"></div>' : ''}
          </div>
        </article>`;
      }).join('')}
    </div>
  </section>
</section>
` }) %>
